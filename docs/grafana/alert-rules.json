        "model": {
          "refId": "A",
          "expr": "max by (model, feature) (drift_ks_pvalue)",
          "instant": true,
          "range": false
        }
      },
      {
        "refId": "B",
        "datasourceUid": "__expr__",
        "model": {
          "refId": "B",
          "type": "reduce",
          "expression": "A",
          "reducer": "last"
        }
      },
      {
        "refId": "C",
        "datasourceUid": "__expr__",
        "model": {
          "refId": "C",
